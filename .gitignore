
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Python
__pycache__/
*.pyc
.venv/

# Secrets — never commit. .env.example files ARE committed (no real values).
.env
.env.*
!.env.example

# Local dev Postgres cluster
.pgdata/
.pgdata.log

# local server logs
.pgstart.out
.pgstart.err
backend/.uvicorn.out
backend/.uvicorn.err
backend/.worker.out
backend/.worker.err
frontend/.next-dev.out
frontend/.next-dev.err
frontend/.next-prod.out
frontend/.next-prod.err

# business-dev docs (contain third-party personal data — not for repo history)
linkedin-profile-package.md
prospect-list-*

# Session credentials written by local dev/CLI login — contains a live JWT
# access token and refresh token. Never commit.
backend/.login.json

# Local runtime logs (server.log lives inside .pgdata, these land at the root)
.pgdata_*.log
backend/.uvicorn.log
backend/.worker.log
frontend/.devserver.log
frontend/.next-dev.log

# Local document store — uploaded project files written at runtime.
backend/.docstore/
.vercel
.env*
