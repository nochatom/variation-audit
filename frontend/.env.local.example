# Copy to .env.local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Google login via Supabase (.25) — an ADDITIONAL sign-in method only; the
# existing email/password + JWT + refresh-token system is unchanged and
# remains the actual session mechanism (see lib/supabase-client.ts,
# app/auth/callback/page.tsx). Both values are public identifiers, safe to
# ship in the client bundle (not secrets) — from Supabase Dashboard ->
# Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sentry error tracking. The DSN is not secret (safe to ship in the client
# bundle) — a hardcoded fallback lives in instrumentation.ts /
# instrumentation-client.ts / next.config.js, so this override is optional
# unless you're pointing at a different Sentry project per environment.
NEXT_PUBLIC_SENTRY_DSN=https://062ca873e45ee9f89035b98c4d5e8361@o4511662990819328.ingest.de.sentry.io/4511662992785488
# Org-level token (Settings -> Auth Tokens) — only needed to enable
# source-map upload on build. Without it, sourcemaps.disable is forced on
# in next.config.js and Sentry stack traces show minified code.
#SENTRY_AUTH_TOKEN=
