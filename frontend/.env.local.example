# Copy to .env.local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Sentry error tracking. The DSN is not secret (safe to ship in the client
# bundle) — a hardcoded fallback lives in instrumentation.ts /
# instrumentation-client.ts / next.config.js, so this override is optional
# unless you're pointing at a different Sentry project per environment.
NEXT_PUBLIC_SENTRY_DSN=https://062ca873e45ee9f89035b98c4d5e8361@o4511662990819328.ingest.de.sentry.io/4511662992785488
# Org-level token (Settings -> Auth Tokens) — only needed to enable
# source-map upload on build. Without it, sourcemaps.disable is forced on
# in next.config.js and Sentry stack traces show minified code.
#SENTRY_AUTH_TOKEN=

# PostHog analytics. The project API key is not secret (safe to ship in the
# client bundle) — a hardcoded fallback lives in lib/posthog-provider.tsx, so
# this override is optional unless you're pointing at a different PostHog
# project per environment. Requests are reverse-proxied through this app's
# own origin at /relay (see next.config.js rewrites()) rather than calling
# eu.i.posthog.com directly, so there's no separate host env var to set here
# — the ingest/assets destinations live in next.config.js instead.
NEXT_PUBLIC_POSTHOG_KEY=phc_y3DH2EhCXy7g7w2qfw7J9yMJrgkYvo5WkzkEiqFrTFas
