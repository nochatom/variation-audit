# Copy to .env (git-ignored) and fill in real values. Never commit secrets.
# All vars use the VA_ prefix (see app/config.py).

# REQUIRED — no insecure default. Generate with: openssl rand -hex 32
VA_JWT_SECRET=

# Database
VA_DATABASE_URL=postgresql+psycopg://localhost/variation_audit

# Engine service (internal, called by the worker only)
VA_ENGINE_BASE_URL=http://localhost:8088
VA_ENGINE_API_KEY=

# Object storage (leave VA_LOCAL_DOC_DIR set for local/dev; unset + configure
# VA_S3_BUCKET for production S3/MinIO)
VA_LOCAL_DOC_DIR=./.docstore
VA_S3_BUCKET=variation-audit-dev
VA_S3_REGION=ap-southeast-2
VA_S3_ENDPOINT_URL=

# CORS — comma-separated origins allowed to call the API
VA_CORS_ORIGINS=["http://localhost:3000"]

# Stripe billing (.23-.25). Unset VA_STRIPE_SECRET_KEY -> NullBillingProvider:
# the billing UI still renders, but checkout/portal/webhook report "not
# configured" instead of a real payment flow. Price IDs are per-plan/interval
# with no default — a plan/interval combo with no price can't be self-serve
# checked out until it's set.
VA_STRIPE_SECRET_KEY=
VA_STRIPE_WEBHOOK_SECRET=
VA_STRIPE_PRICE_PRO=
VA_STRIPE_PRICE_PRO_ANNUAL=
VA_STRIPE_PRICE_ENTERPRISE=
# Optional — unset means Pro/Enterprise orgs are hard-blocked at their plan's
# included seat count instead of billing overage for extra seats.
VA_STRIPE_PRICE_SEAT_OVERAGE=
#VA_BILLING_GRACE_PERIOD_DAYS=7

# Rate limiting (per client IP; slowapi/limits grammar). Defaults shown are
# the production values baked into app/config.py — override only if needed.
# Behind a proxy/LB, run uvicorn with --proxy-headers --forwarded-allow-ips
# so limits key on the real client IP, not the proxy.
#VA_RATE_LIMIT_DEFAULT=300/minute
#VA_RATE_LIMIT_AUTH=5/minute
#VA_RATE_LIMIT_UPLOADS=20/minute
#VA_RATE_LIMIT_ANALYSIS=10/hour
# REQUIRED for multi-worker/multi-instance deployments — all processes must
# share one budget (in-memory default is per-process):
#VA_RATE_LIMIT_STORAGE_URI=redis://localhost:6379
